  <!-- Local paths are deliberately kept out of source control. Copy RimWorld.local.props.example to RimWorld.local.props. -->
  <Import Project="$(MSBuildProjectDirectory)\..\RimWorld.local.props" Condition="Exists('$(MSBuildProjectDirectory)\..\RimWorld.local.props')" />
  <PropertyGroup>
