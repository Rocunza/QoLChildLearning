  <!-- The original RimWorld and Harmony game libraries are used only as references; never copied into outputs. -->
  <Target Name="ValidateRimWorld16References" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldManagedDir)' == ''" Text="QoL: Child Learning: RimWorldManagedDir is not configured. Copy RimWorld.local.props.example to RimWorld.local.props and edit RimWorldDir, or pass /p:RimWorldDir=... (see BUILDING.md)." />
    <Error Condition="'$(HarmonyDllPath)' == ''" Text="QoL: Child Learning: HarmonyDllPath is not configured. Set HarmonyDllPath to your Harmony 1.6 0Harmony.dll in RimWorld.local.props (see BUILDING.md)." />
