<Project Sdk="Microsoft.NET.Sdk">
  <!-- RimWorld 1.7 port; original 1.6 source tree and build are independent. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>QoLChildLearning</AssemblyName>
    <RootNamespace>ZCN.QoL.ChildLearning</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <Import Project="$(MSBuildProjectDirectory)\..\..\RimWorld17.local.props" Condition="Exists('$(MSBuildProjectDirectory)\..\..\RimWorld17.local.props')" />
  <PropertyGroup>
    <RimWorld17ManagedDir Condition="'$(RimWorld17ManagedDir)' == '' and '$(RimWorld17GameDir)' != '' and Exists('$(RimWorld17GameDir)\Assembly-CSharp.dll')">$(RimWorld17GameDir)</RimWorld17ManagedDir>
    <RimWorld17ManagedDir Condition="'$(RimWorld17ManagedDir)' == '' and '$(RimWorld17GameDir)' != '' and Exists('$(RimWorld17GameDir)\RimWorld\Assembly-CSharp.dll')">$(RimWorld17GameDir)\RimWorld</RimWorld17ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorld17ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorld17ManagedDir)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(RimWorld17ManagedDir)\Waylith.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(Harmony17DllPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateRimWorld17References" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorld17ManagedDir)' == ''" Text="QoLChildLearning: set RimWorld17GameDir or RimWorld17ManagedDir in RimWorld17.local.props." />
    <Error Condition="'$(Harmony17DllPath)' == ''" Text="QoLChildLearning: set Harmony17DllPath to Harmony 3 assembly." />
    <Error Condition="!Exists('$(RimWorld17ManagedDir)\Assembly-CSharp.dll')" Text="Missing RW17 Assembly-CSharp.dll" />
    <Error Condition="!Exists('$(RimWorld17ManagedDir)\UnityStubs.dll')" Text="Missing RW17 UnityStubs.dll" />
    <Error Condition="!Exists('$(RimWorld17ManagedDir)\Waylith.dll')" Text="Missing RW17 Waylith.dll" />
    <Error Condition="!Exists('$(Harmony17DllPath)')" Text="Missing RW17 Harmony 3 0Harmony.dll" />
  </Target>
</Project>
